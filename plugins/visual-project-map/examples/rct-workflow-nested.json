{
  "title": "RCT Curation Workflow (Nested Modules)",
  "modules": [
    { "id": "phase_input",  "label": "Input Pipeline",     "color": "#e8edf3", "borderColor": "#a8b8cc" },
    { "id": "phase_review", "label": "AI Review Pipeline",  "color": "#f3ede8", "borderColor": "#ccb8a8" },
    { "id": "phase_output", "label": "Validation & Output", "color": "#e8f3ed", "borderColor": "#a8ccb8" },

    { "id": "mod_disc",    "label": "Discovery",         "color": "#dbeafe", "borderColor": "#93c5fd", "parent": "phase_input" },
    { "id": "mod_acq",     "label": "Acquisition",       "color": "#e0e7ff", "borderColor": "#a5b4fc", "parent": "phase_input" },
    { "id": "mod_screen",  "label": "Screening",         "color": "#fef2f2", "borderColor": "#fca5a5", "parent": "phase_review" },
    { "id": "mod_struct",  "label": "Structural Checks", "color": "#fff7ed", "borderColor": "#fdba74", "parent": "phase_review" },
    { "id": "mod_paper",   "label": "Paper–Data Match",  "color": "#fefce8", "borderColor": "#fde047", "parent": "phase_review" },
    { "id": "mod_extract", "label": "Field Extraction",  "color": "#f0fdf4", "borderColor": "#86efac", "parent": "phase_output" },
    { "id": "mod_verify",  "label": "ATE Verification",  "color": "#eff6ff", "borderColor": "#93c5fd", "parent": "phase_output" },
    { "id": "mod_enrich",  "label": "Field Enrichment",  "color": "#f5f3ff", "borderColor": "#c4b5fd", "parent": "phase_output" },
    { "id": "mod_term",    "label": "Terminals",         "color": "#f1f5f9", "borderColor": "#94a3b8", "parent": "phase_output" }
  ],
  "nodes": [
    { "id": "D_new",       "module": "mod_disc",    "label": "discovery.new",
      "style": { "trust": "raw" },
      "files": { "reads": ["_discovery/registry/discovery_registry.csv"] } },
    { "id": "D_scored",    "module": "mod_disc",    "label": "discovery.scored",
      "style": { "trust": "ai_generated" },
      "files": { "reads": ["discovery_registry.csv"], "writes": ["discovery_registry.csv → score, tier columns"] } },
    { "id": "D_auto",      "module": "mod_disc",    "label": "discovery.auto_approved",
      "style": { "trust": "ai_generated" } },
    { "id": "D_marginal",  "module": "mod_disc",    "label": "discovery.marginal",
      "style": { "trust": "needs_human_review" } },
    { "id": "D_human_yes", "module": "mod_disc",    "label": "discovery.human_approved",
      "style": { "trust": "human_verified" } },
    { "id": "D_approved",  "module": "mod_disc",    "label": "discovery.approved",
      "style": { "trust": "human_verified" } },
    { "id": "D_rejected",  "module": "mod_disc",    "label": "discovery.rejected",
      "style": { "trust": "raw" },
      "files": { "writes": ["discovery_registry.csv → status: excluded"] } },

    { "id": "DL",  "module": "mod_acq", "label": "acquisition.downloaded",
      "style": { "trust": "ai_generated" },
      "files": { "writes": ["data/data_downloaded/{source}/{dataset}/"] } },
    { "id": "STD", "module": "mod_acq", "label": "acquisition.standardized",
      "style": { "trust": "ai_generated" },
      "files": { "reads": ["data/data_downloaded/{source}/{dataset}/"], "writes": ["data/data_standardized/{source}/{dataset}/standardized_data.csv"] } },

    { "id": "A_pend",  "module": "mod_screen", "label": "screening.pending",
      "style": { "trust": "raw" },
      "files": { "reads": ["standardized_data.csv", "paper.pdf"] } },
    { "id": "A_pass",  "module": "mod_screen", "label": "screening.ai_pass",
      "style": { "trust": "ai_generated" },
      "files": { "writes": ["metadata/{source}/{dataset}/curation.json → ai_review.screening"] } },
    { "id": "A_fail",  "module": "mod_screen", "label": "screening.ai_fail",
      "style": { "trust": "ai_generated" } },
    { "id": "A_hpass", "module": "mod_screen", "label": "screening.human_pass",
      "style": { "trust": "human_verified" } },
    { "id": "A_hfail", "module": "mod_screen", "label": "screening.human_fail",
      "style": { "trust": "human_verified" } },
    { "id": "A_ready", "module": "mod_screen", "label": "screening.ready",
      "style": { "trust": "human_verified" } },

    { "id": "B_pend",  "module": "mod_struct", "label": "structural.pending",
      "style": { "trust": "raw" } },
    { "id": "B_pass",  "module": "mod_struct", "label": "structural.ai_pass",
      "style": { "trust": "ai_generated" },
      "files": { "writes": ["curation.json → ai_review.structural"] } },
    { "id": "B_warn",  "module": "mod_struct", "label": "structural.ai_warn",
      "style": { "trust": "needs_human_review" } },
    { "id": "B_fail",  "module": "mod_struct", "label": "structural.ai_fail",
      "style": { "trust": "needs_human_review" } },
    { "id": "B_corr",  "module": "mod_struct", "label": "structural.pending_correction",
      "style": { "trust": "needs_human_review" } },
    { "id": "B_hpass", "module": "mod_struct", "label": "structural.human_pass",
      "style": { "trust": "human_verified" } },

    { "id": "C_nopaper", "module": "mod_paper", "label": "correspondence.no_paper",
      "style": { "trust": "raw" } },
    { "id": "C_pend",    "module": "mod_paper", "label": "correspondence.pending",
      "style": { "trust": "raw" },
      "files": { "reads": ["paper.pdf", "curation.json"] } },
    { "id": "C_pass",    "module": "mod_paper", "label": "correspondence.ai_pass",
      "style": { "trust": "ai_generated" },
      "files": { "writes": ["curation.json → ai_review.correspondence"] } },
    { "id": "C_warn",    "module": "mod_paper", "label": "correspondence.ai_warn",
      "style": { "trust": "needs_human_review" } },
    { "id": "C_fail",    "module": "mod_paper", "label": "correspondence.ai_fail",
      "style": { "trust": "needs_human_review" } },
    { "id": "C_corr",    "module": "mod_paper", "label": "correspondence.pending_correction",
      "style": { "trust": "needs_human_review" } },
    { "id": "C_hpass",   "module": "mod_paper", "label": "correspondence.human_pass",
      "style": { "trust": "human_verified" } },
    { "id": "C_ready",   "module": "mod_paper", "label": "correspondence.ready",
      "style": { "trust": "human_verified" } },

    { "id": "X_pend", "module": "mod_extract", "label": "extraction.pending",
      "style": { "trust": "raw" },
      "files": { "reads": ["paper.pdf", "curation.json"] } },
    { "id": "X_part", "module": "mod_extract", "label": "extraction.partial",
      "style": { "trust": "ai_generated" },
      "files": { "writes": ["curation.json → metadata fields"] } },
    { "id": "X_comp", "module": "mod_extract", "label": "extraction.complete",
      "style": { "trust": "ai_generated" } },
    { "id": "X_hver", "module": "mod_extract", "label": "extraction.human_verified",
      "style": { "trust": "human_verified" } },

    { "id": "E_pend",  "module": "mod_verify", "label": "verification.pending",
      "style": { "trust": "raw" },
      "files": { "reads": ["standardized_data.csv", "curation.json"] } },
    { "id": "E_comp",  "module": "mod_verify", "label": "verification.computed",
      "style": { "trust": "ai_generated" },
      "files": { "writes": ["results/verification/"] } },
    { "id": "E_match", "module": "mod_verify", "label": "verification.match",
      "style": { "trust": "ai_generated" } },
    { "id": "E_mis",   "module": "mod_verify", "label": "verification.mismatch",
      "style": { "trust": "needs_human_review" } },
    { "id": "E_hres",  "module": "mod_verify", "label": "verification.human_resolved",
      "style": { "trust": "human_verified" } },
    { "id": "E_unver", "module": "mod_verify", "label": "verification.unverifiable",
      "style": { "trust": "ai_generated" } },
    { "id": "E_ready", "module": "mod_verify", "label": "verification.ready",
      "style": { "trust": "ai_generated" } },

    { "id": "FG_pend", "module": "mod_enrich", "label": "enrichment.pending",
      "style": { "trust": "raw" },
      "files": { "reads": ["paper.pdf"] } },
    { "id": "FG_part", "module": "mod_enrich", "label": "enrichment.partial",
      "style": { "trust": "ai_generated" },
      "files": { "writes": ["curation.json → enrichment fields"] } },
    { "id": "FG_comp", "module": "mod_enrich", "label": "enrichment.complete",
      "style": { "trust": "ai_generated" } },

    { "id": "GATE", "module": "mod_term", "label": "Inclusion Gate", "style": { "trust": "raw", "shape": "diamond", "color": "#faf5ff", "borderColor": "#a78bfa" } },
    { "id": "INC",  "module": "mod_term", "label": "INCLUDED",      "style": { "trust": "human_verified", "color": "#d1fae5", "borderColor": "#6ee7b7" },
      "files": { "writes": ["dataset_registry.csv", "metadata.json"] } },
    { "id": "EXC",  "module": "mod_term", "label": "EXCLUDED",      "style": { "trust": "human_verified", "color": "#fee2e2", "borderColor": "#fca5a5" } },
    { "id": "FAIL", "module": "mod_term", "label": "FAILED",        "style": { "trust": "raw", "color": "#fee2e2", "borderColor": "#fca5a5" } }
  ],
  "edges": [
    { "source": "D_new",      "target": "D_scored",    "label": "hard filter + score",     "style": "solid", "actor": "script",
      "details": { "script": "scripts/discovery/score_candidates.py", "input": ["_discovery/registry/discovery_registry.csv"], "output": ["_discovery/registry/discovery_registry.csv"], "updates": ["discovery_registry.csv → score, tier columns"] } },
    { "source": "D_scored",   "target": "D_auto",      "label": "score ≥ 70",          "style": "solid", "actor": "script" },
    { "source": "D_scored",   "target": "D_marginal",  "label": "score 50–69",         "style": "solid", "actor": "script" },
    { "source": "D_marginal", "target": "D_human_yes", "label": "human: yes",               "style": "solid", "actor": "human" },

    { "source": "D_auto",      "target": "D_approved",  "label": "auto approved",  "style": "solid", "actor": "script" },
    { "source": "D_human_yes", "target": "D_approved",  "label": "human approved", "style": "solid", "actor": "human" },
    { "source": "D_approved",  "target": "DL",          "label": "download",       "style": "solid", "actor": "script" },

    { "source": "D_new",      "target": "D_rejected",  "label": "fail filter",   "style": "solid", "actor": "script" },
    { "source": "D_scored",   "target": "D_rejected",  "label": "score too low", "style": "solid", "actor": "script" },
    { "source": "D_marginal", "target": "D_rejected",  "label": "human: no",     "style": "solid", "actor": "human" },
    { "source": "D_rejected", "target": "EXC",         "label": "excluded at discovery", "style": "solid", "actor": "script" },

    { "source": "DL", "target": "STD", "label": "clean_*.py", "style": "solid", "actor": "script",
      "details": { "script": "scripts/sources/{source}/clean_*.py", "input": ["data/data_downloaded/{source}/{dataset}/"], "output": ["data/data_standardized/{source}/{dataset}/standardized_data.csv"], "docs": "docs/plan/04_standardization_procedure.md" } },

    { "source": "STD", "target": "A_pend", "label": "/ai-review Q1–Q4", "style": "solid", "actor": "ai",
      "details": { "script": "scripts/review/ai_review.py", "input": ["data/data_standardized/{source}/{dataset}/standardized_data.csv", "data/data_papers/{source}/{dataset}/paper.pdf"], "output": ["metadata/{source}/{dataset}/curation.json"], "updates": ["curation.json → ai_review.screening"], "docs": "docs/procedure/review_workflow.md" } },

    { "source": "A_pend", "target": "A_pass",  "label": "all 4 pass",          "style": "solid", "actor": "ai" },
    { "source": "A_pend", "target": "A_fail",  "label": "any fail",            "style": "solid", "actor": "ai" },
    { "source": "A_pass", "target": "A_hpass", "label": "human confirms",      "style": "solid", "actor": "human" },
    { "source": "A_fail", "target": "A_hfail", "label": "human confirms fail", "style": "solid", "actor": "human" },
    { "source": "A_fail", "target": "A_hpass", "label": "human overrides",     "style": "dashed", "actor": "human" },

    { "source": "A_pass",  "target": "A_ready", "label": "screened",  "style": "solid", "actor": "ai" },
    { "source": "A_hpass", "target": "A_ready", "label": "confirmed", "style": "solid", "actor": "human" },

    { "source": "A_ready", "target": "B_pend",    "label": "/ai-review Q5–Q9",    "style": "solid", "actor": "ai" },
    { "source": "A_ready", "target": "C_nopaper", "label": "no paper",                 "style": "solid", "actor": "script" },
    { "source": "A_ready", "target": "C_pend",    "label": "/ai-review Q10–Q14",  "style": "solid", "actor": "ai" },
    { "source": "A_ready", "target": "X_pend",    "label": "extract fields",           "style": "solid", "actor": "ai",
      "details": { "script": "scripts/review/extract_fields.py", "input": ["data/data_papers/{source}/{dataset}/paper.pdf", "metadata/{source}/{dataset}/curation.json"], "output": ["metadata/{source}/{dataset}/curation.json"], "docs": "docs/agent_instructions/tasks/extract_all_fields.md" } },
    { "source": "A_ready", "target": "FG_pend",   "label": "enrich",                   "style": "solid", "actor": "ai" },

    { "source": "A_hfail", "target": "EXC", "label": "not eligible", "style": "solid", "actor": "human" },

    { "source": "B_pend", "target": "B_pass",  "label": "all pass",       "style": "solid", "actor": "ai" },
    { "source": "B_pend", "target": "B_warn",  "label": "warnings",       "style": "solid", "actor": "ai" },
    { "source": "B_pend", "target": "B_fail",  "label": "critical",       "style": "solid", "actor": "ai" },
    { "source": "B_pass", "target": "B_hpass", "label": "human confirms", "style": "solid", "actor": "human" },
    { "source": "B_warn", "target": "B_hpass", "label": "human: OK",      "style": "solid", "actor": "human" },
    { "source": "B_warn", "target": "B_corr",  "label": "needs fix",      "style": "solid", "actor": "human" },
    { "source": "B_fail", "target": "B_corr",  "label": "fixable",        "style": "solid", "actor": "human" },
    { "source": "B_corr", "target": "B_pend",  "label": "fix + re-run",   "style": "dashed", "actor": "mixed" },

    { "source": "C_nopaper", "target": "C_pend",  "label": "paper downloaded", "style": "dashed", "actor": "script",
      "details": { "script": "scripts/download_papers.py", "input": ["metadata/{source}/{dataset}/metadata.json"], "output": ["data/data_papers/{source}/{dataset}/paper.pdf"] } },
    { "source": "C_pend",    "target": "C_pass",  "label": "all match",        "style": "solid", "actor": "ai" },
    { "source": "C_pend",    "target": "C_warn",  "label": "discrepancies",    "style": "solid", "actor": "ai" },
    { "source": "C_pend",    "target": "C_fail",  "label": "major mismatch",   "style": "solid", "actor": "ai" },
    { "source": "C_pass",    "target": "C_hpass", "label": "human confirms",   "style": "solid", "actor": "human" },
    { "source": "C_warn",    "target": "C_hpass", "label": "acceptable",       "style": "solid", "actor": "human" },
    { "source": "C_warn",    "target": "C_corr",  "label": "needs fix",        "style": "solid", "actor": "human" },
    { "source": "C_fail",    "target": "C_corr",  "label": "fixable",          "style": "solid", "actor": "human" },
    { "source": "C_corr",    "target": "C_pend",  "label": "fix + re-run",     "style": "dashed", "actor": "mixed" },

    { "source": "C_hpass",   "target": "C_ready", "label": "verified",  "style": "solid", "actor": "human" },
    { "source": "C_nopaper", "target": "C_ready", "label": "accepted",  "style": "solid", "actor": "script" },
    { "source": "C_ready",   "target": "GATE",    "label": "C ready",   "style": "solid", "actor": "script" },

    { "source": "X_pend", "target": "X_part", "label": "some fields",    "style": "solid", "actor": "ai" },
    { "source": "X_pend", "target": "X_comp", "label": "all fields",     "style": "solid", "actor": "ai" },
    { "source": "X_part", "target": "X_pend", "label": "retry",          "style": "dashed", "actor": "ai" },
    { "source": "X_part", "target": "X_comp", "label": "remaining done", "style": "solid", "actor": "ai" },
    { "source": "X_comp", "target": "X_hver", "label": "spot-check OK",  "style": "solid", "actor": "human" },
    { "source": "X_comp", "target": "X_pend", "label": "errors found",   "style": "dashed", "actor": "human" },

    { "source": "X_comp", "target": "E_pend", "label": "verify_findings.py", "style": "solid", "actor": "script",
      "details": { "script": "scripts/verify_findings.py", "input": ["data/data_standardized/{source}/{dataset}/standardized_data.csv", "metadata/{source}/{dataset}/curation.json"], "output": ["results/verification/"], "docs": "docs/plan/05_quality_assurance.md" } },
    { "source": "X_hver", "target": "E_pend", "label": "verify_findings.py", "style": "solid", "actor": "script" },

    { "source": "E_pend", "target": "E_unver", "label": "no published ATE",    "style": "solid", "actor": "script" },
    { "source": "E_pend", "target": "E_comp",  "label": "ATE computed",        "style": "solid", "actor": "script" },
    { "source": "E_comp", "target": "E_match", "label": "sign + magnitude OK", "style": "solid", "actor": "script" },
    { "source": "E_comp", "target": "E_mis",   "label": "mismatch",            "style": "solid", "actor": "script" },
    { "source": "E_mis",  "target": "E_hres",  "label": "spec difference",     "style": "solid", "actor": "human" },

    { "source": "E_mis", "target": "STD", "label": "data error", "style": "dashed", "actor": "mixed" },

    { "source": "E_match", "target": "E_ready", "label": "matched",        "style": "solid", "actor": "script" },
    { "source": "E_hres",  "target": "E_ready", "label": "resolved",       "style": "solid", "actor": "human" },
    { "source": "E_unver", "target": "E_ready", "label": "no published ATE", "style": "solid", "actor": "script" },
    { "source": "E_ready", "target": "GATE",    "label": "E ready",         "style": "solid", "actor": "script" },

    { "source": "FG_pend", "target": "FG_part", "label": "extract_single_field", "style": "solid", "actor": "ai",
      "details": { "script": "scripts/review/extract_fields.py --field {name}", "input": ["data/data_papers/{source}/{dataset}/paper.pdf"], "output": ["metadata/{source}/{dataset}/curation.json"], "docs": "docs/agent_instructions/tasks/extract_single_field.md" } },
    { "source": "FG_part", "target": "FG_comp", "label": "continue",             "style": "solid", "actor": "ai" },

    { "source": "B_hpass", "target": "GATE", "label": "B ready",  "style": "solid", "actor": "script" },
    { "source": "X_hver",  "target": "GATE", "label": "D ready",  "style": "solid", "actor": "script" },
    { "source": "FG_comp", "target": "GATE", "label": "optional", "style": "dashed", "actor": "script" },

    { "source": "GATE", "target": "INC", "label": "all verified", "style": "solid", "actor": "script",
      "details": { "script": "scripts/registry/build.py", "input": ["metadata/{source}/{dataset}/curation.json"], "output": ["dataset_registry.csv"], "docs": "docs/plan/05_quality_assurance.md" } },

    { "source": "DL",     "target": "EXC",  "label": "not RCT / no data", "style": "solid", "actor": "human" },
    { "source": "B_fail", "target": "EXC",  "label": "unfixable",         "style": "solid", "actor": "ai" },
    { "source": "C_fail", "target": "EXC",  "label": "unfixable",         "style": "solid", "actor": "ai" },

    { "source": "DL",   "target": "FAIL", "label": "download error", "style": "solid", "actor": "script" },
    { "source": "FAIL", "target": "DL",   "label": "retry",          "style": "dashed", "actor": "script" }
  ],
  "legend": {
    "trustLevels": {
      "raw":                { "label": "Raw",          "borderStyle": "solid",  "borderWidth": 1.5, "color": "#f1f5f9", "borderColor": "#94a3b8" },
      "ai_generated":       { "label": "AI Generated", "borderStyle": "dashed", "borderWidth": 1.5, "color": "#fef3c7", "borderColor": "#f59e0b", "tag": { "text": "AI", "bg": "#fef3c7", "color": "#92400e" } },
      "needs_human_review": { "label": "Needs Review", "borderStyle": "solid",  "borderWidth": 2.5, "color": "#fee2e2", "borderColor": "#ef4444", "tag": { "text": "review", "bg": "#fee2e2", "color": "#991b1b" } },
      "human_verified":     { "label": "Verified",     "borderStyle": "solid",  "borderWidth": 3.5, "color": "#d1fae5", "borderColor": "#10b981", "tag": { "text": "verified", "bg": "#d1fae5", "color": "#065f46" } }
    }
  }
}
