{
  "title": "Data Pipeline",
  "modules": [
    { "id": "mod_ingest",    "label": "Data Ingestion",      "color": "#dbeafe", "borderColor": "#93c5fd" },
    { "id": "mod_transform", "label": "Data Transformation", "color": "#e0e7ff", "borderColor": "#a5b4fc" },
    { "id": "mod_validate",  "label": "Validation",          "color": "#fff7ed", "borderColor": "#fdba74" },
    { "id": "mod_load",      "label": "Loading",             "color": "#f0fdf4", "borderColor": "#86efac" },
    { "id": "mod_term",      "label": "Terminals",           "color": "#f1f5f9", "borderColor": "#94a3b8" }
  ],
  "nodes": [
    { "id": "ing_fetch",   "module": "mod_ingest",    "label": "fetch_api",       "style": { "trust": "normal" } },
    { "id": "ing_parse",   "module": "mod_ingest",    "label": "parse_response",  "style": { "trust": "auto" } },
    { "id": "ing_store",   "module": "mod_ingest",    "label": "store_raw",       "style": { "trust": "auto" } },

    { "id": "tfm_normalize", "module": "mod_transform", "label": "normalize",      "style": { "trust": "auto" } },
    { "id": "tfm_dedup",     "module": "mod_transform", "label": "deduplicate",    "style": { "trust": "auto" } },
    { "id": "tfm_enrich",    "module": "mod_transform", "label": "enrich_fields",  "style": { "trust": "ai" } },

    { "id": "val_schema",  "module": "mod_validate", "label": "schema_check",  "style": { "trust": "auto", "shape": "diamond" } },
    { "id": "val_quality", "module": "mod_validate", "label": "quality_score", "style": { "trust": "ai" } },
    { "id": "val_approve", "module": "mod_validate", "label": "human_review",  "style": { "trust": "verified" } },

    { "id": "load_stage", "module": "mod_load", "label": "load_staging",    "style": { "trust": "auto" } },
    { "id": "load_prod",  "module": "mod_load", "label": "load_production", "style": { "trust": "verified" } },

    { "id": "COMPLETE", "module": "mod_term", "label": "COMPLETE", "style": { "trust": "normal", "color": "#d1fae5", "borderColor": "#6ee7b7" } },
    { "id": "FAILED",   "module": "mod_term", "label": "FAILED",   "style": { "trust": "normal", "color": "#fee2e2", "borderColor": "#fca5a5" } }
  ],
  "edges": [
    { "source": "ing_fetch", "target": "ing_parse", "label": "raw response", "style": "solid", "actor": "script",
      "details": { "script": "scripts/ingest/fetch.py", "input": ["config/sources.yaml"], "output": ["data/raw/"], "docs": "Fetches data from configured API endpoints" } },
    { "source": "ing_parse", "target": "ing_store", "label": "parsed records", "style": "solid", "actor": "script" },
    { "source": "ing_store", "target": "tfm_normalize", "label": "raw files", "style": "solid", "actor": "script",
      "details": { "script": "scripts/transform/normalize.py", "input": ["data/raw/"], "output": ["data/normalized/"], "updates": ["manifest.json"] } },

    { "source": "tfm_normalize", "target": "tfm_dedup", "label": "normalized", "style": "solid", "actor": "script" },
    { "source": "tfm_dedup", "target": "tfm_enrich", "label": "unique records", "style": "solid", "actor": "script" },
    { "source": "tfm_enrich", "target": "val_schema", "label": "enriched", "style": "solid", "actor": "ai" },

    { "source": "val_schema", "target": "val_quality", "label": "schema valid", "style": "solid", "actor": "script" },
    { "source": "val_schema", "target": "tfm_normalize", "label": "schema invalid", "style": "dashed", "actor": "script" },
    { "source": "val_schema", "target": "FAILED", "label": "unfixable", "style": "dashed", "actor": "script" },
    { "source": "val_quality", "target": "val_approve", "label": "score above threshold", "style": "solid", "actor": "ai",
      "details": { "script": "scripts/validate/quality.py", "input": ["data/normalized/", "config/quality_rules.yaml"], "output": ["reports/quality_scores.csv"] } },
    { "source": "val_quality", "target": "FAILED", "label": "low quality", "style": "dashed", "actor": "ai" },

    { "source": "val_approve", "target": "load_stage", "label": "approved", "style": "solid", "actor": "human" },
    { "source": "val_approve", "target": "tfm_normalize", "label": "needs rework", "style": "dashed", "actor": "human" },
    { "source": "load_stage", "target": "load_prod", "label": "staging OK", "style": "solid", "actor": "script" },
    { "source": "load_prod", "target": "COMPLETE", "label": "deployed", "style": "solid", "actor": "human" },
    { "source": "load_stage", "target": "FAILED", "label": "staging error", "style": "dashed", "actor": "script" }
  ],
  "legend": {
    "trustLevels": {
      "normal":   { "label": "Unverified",  "borderStyle": "solid",  "borderWidth": 1.5 },
      "auto":     { "label": "Automated",   "borderStyle": "solid",  "borderWidth": 1.5, "tag": { "text": "auto", "bg": "#dbeafe", "color": "#1e40af" } },
      "ai":       { "label": "AI-Assisted", "borderStyle": "dashed", "borderWidth": 1.5, "tag": { "text": "AI",   "bg": "#fef3c7", "color": "#92400e" } },
      "verified": { "label": "Human-Verified", "borderStyle": "solid", "borderWidth": 3.5, "tag": { "text": "verified", "bg": "#d1fae5", "color": "#065f46" } }
    }
  }
}
