{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Graph Viewer Input",
  "type": "object",
  "required": ["title", "modules", "nodes", "edges"],
  "properties": {
    "title": { "type": "string" },
    "modules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "label", "color", "borderColor"],
        "properties": {
          "id":          { "type": "string" },
          "label":       { "type": "string" },
          "color":       { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
          "borderColor": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
          "parent":      { "type": "string", "description": "ID of parent phase module (for nesting)" },
          "interface": {
            "type": "object",
            "description": "Module interface contract (inputs/outputs)",
            "properties": {
              "inputs": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "name": { "type": "string" },
                    "description": { "type": "string" },
                    "format": { "type": "string" },
                    "example": { "type": "string" }
                  },
                  "required": ["name"]
                }
              },
              "outputs": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "name": { "type": "string" },
                    "description": { "type": "string" },
                    "format": { "type": "string" },
                    "example": { "type": "string" }
                  },
                  "required": ["name"]
                }
              }
            }
          }
        }
      }
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "module", "label"],
        "properties": {
          "id":     { "type": "string" },
          "module": { "type": "string" },
          "label":  { "type": "string" },
          "style": {
            "type": "object",
            "properties": {
              "trust":       { "type": "string" },
              "shape":       { "type": "string", "enum": ["round-rectangle", "diamond", "ellipse", "rectangle", "hexagon"] },
              "color":       { "type": "string" },
              "borderColor": { "type": "string" }
            }
          },
          "files": {
            "type": "object",
            "description": "File I/O annotations",
            "properties": {
              "reads":  { "type": "array", "items": { "type": "string" } },
              "writes": { "type": "array", "items": { "type": "string" } }
            }
          },
          "_isInterfacePort": {
            "type": "boolean",
            "description": "True if this node is a module interface port"
          },
          "_portDirection": {
            "type": "string",
            "enum": ["input", "output"],
            "description": "Direction of the interface port"
          },
          "interfaceContract": {
            "type": "object",
            "description": "Contract details for interface port nodes",
            "properties": {
              "name":        { "type": "string" },
              "description": { "type": "string" },
              "format":      { "type": "string" },
              "example":     { "type": "string" }
            }
          }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source", "target"],
        "properties": {
          "id":     { "type": "string", "description": "Optional edge ID (auto-generated as e1, e2, ... if omitted)" },
          "source": { "type": "string" },
          "target": { "type": "string" },
          "label":  { "type": "string" },
          "style":  { "type": "string", "enum": ["solid", "dashed"] },
          "actor":  { "type": "string", "enum": ["human", "ai", "script", "mixed"] },
          "details": {
            "type": "object",
            "properties": {
              "script":  { "type": "string" },
              "input":   { "type": "array", "items": { "type": "string" } },
              "output":  { "type": "array", "items": { "type": "string" } },
              "updates": { "type": "array", "items": { "type": "string" } },
              "docs":    { "type": "string" }
            }
          }
        }
      }
    },
    "legend": {
      "type": "object",
      "properties": {
        "trustLevels": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "label":       { "type": "string" },
              "borderStyle": { "type": "string" },
              "borderWidth": { "type": "number" },
              "color":       { "type": "string", "description": "Background color for provenance view" },
              "borderColor": { "type": "string", "description": "Border color for provenance view" },
              "tag": {
                "type": "object",
                "properties": {
                  "text":  { "type": "string" },
                  "bg":    { "type": "string" },
                  "color": { "type": "string" }
                }
              }
            }
          }
        }
      }
    },
    "plan": {
      "type": "object",
      "properties": {
        "summary": {
          "type": "object",
          "properties": {
            "goal": { "type": "string" },
            "tasks": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": { "type": "string" },
                  "title": { "type": "string" },
                  "nodeIds": { "type": "array", "items": { "type": "string" } }
                },
                "required": ["id", "title"]
              }
            }
          }
        },
        "annotations": {
          "type": "object",
          "properties": {
            "nodes": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "properties": {
                  "status": { "enum": ["add", "modify", "remove"] },
                  "description": { "type": "string" }
                },
                "required": ["status"]
              }
            },
            "edges": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "properties": {
                  "status": { "enum": ["add", "modify", "remove"] },
                  "description": { "type": "string" }
                },
                "required": ["status"]
              }
            },
            "modules": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "properties": {
                  "status": { "enum": ["add", "modify"] },
                  "description": { "type": "string" }
                },
                "required": ["status"]
              }
            }
          }
        }
      }
    }
  }
}
