{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Graph Viewer Input",
  "type": "object",
  "required": ["title", "modules", "nodes", "edges"],
  "properties": {
    "title": { "type": "string" },
    "description": { "type": "string", "description": "One-paragraph overview of the graph's purpose and scope" },
    "modules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "label", "color", "borderColor"],
        "properties": {
          "id":          { "type": "string" },
          "label":       { "type": "string" },
          "color":       { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
          "borderColor": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
          "description": { "type": "string", "description": "Natural language description of what this module does and why it exists" },
          "role": {
            "type": "string",
            "enum": ["process", "data"],
            "description": "Visual role: process (does work, round-rectangle) or data (artifact, hexagon)"
          },
          "status": {
            "type": "string",
            "enum": ["planned", "draft", "ai-tested", "needs-review", "verified"],
            "description": "Implementation status: planned (no code), draft (untested), ai-tested (default), needs-review (flagged), verified (human-approved)"
          },
          "parent":      { "type": "string", "description": "ID of parent phase module (for nesting)" },
          "interface": {
            "type": "object",
            "description": "Module interface contract (inputs/outputs)",
            "properties": {
              "inputs": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "name": { "type": "string" },
                    "description": { "type": "string" },
                    "format": { "type": "string" },
                    "example": { "type": "string" }
                  },
                  "required": ["name"]
                }
              },
              "outputs": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "name": { "type": "string" },
                    "description": { "type": "string" },
                    "format": { "type": "string" },
                    "example": { "type": "string" }
                  },
                  "required": ["name"]
                }
              }
            }
          },
          "confidence": {
            "type": "string",
            "enum": ["high", "medium", "low", "unknown"],
            "description": "How confident the generation is in this module's design (high=standard pattern, medium=reasonable guess, low=needs domain input)"
          },
          "needsHumanReview": {
            "type": "boolean",
            "description": "True if this module requires domain expertise to validate"
          },
          "checkpointReason": {
            "type": "string",
            "description": "Why this module needs human review or has low confidence"
          }
        }
      }
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "module", "label"],
        "properties": {
          "id":     { "type": "string" },
          "module": { "type": "string" },
          "label":  { "type": "string" },
          "description": { "type": "string", "description": "Natural language description of what happens at this state or step" },
          "role": {
            "type": "string",
            "enum": ["process", "data"],
            "description": "Visual role: process (does work, round-rectangle) or data (artifact, hexagon). Overrides style.shape."
          },
          "status": {
            "type": "string",
            "enum": ["planned", "draft", "ai-tested", "needs-review", "verified"],
            "description": "Implementation status: planned (no code), draft (untested), ai-tested (default), needs-review (flagged), verified (human-approved)"
          },
          "style": {
            "type": "object",
            "properties": {
              "trust":       { "type": "string" },
              "shape":       { "type": "string", "enum": ["round-rectangle", "diamond", "ellipse", "rectangle", "hexagon"] },
              "color":       { "type": "string" },
              "borderColor": { "type": "string" }
            }
          },
          "files": {
            "type": "object",
            "description": "File I/O annotations",
            "properties": {
              "reads":  { "type": "array", "items": { "type": "string" } },
              "writes": { "type": "array", "items": { "type": "string" } }
            }
          },
          "_isInterfacePort": {
            "type": "boolean",
            "description": "True if this node is a module interface port"
          },
          "_portDirection": {
            "type": "string",
            "enum": ["input", "output"],
            "description": "Direction of the interface port"
          },
          "interfaceContract": {
            "type": "object",
            "description": "Contract details for interface port nodes",
            "properties": {
              "name":        { "type": "string" },
              "description": { "type": "string" },
              "format":      { "type": "string" },
              "example":     { "type": "string" }
            }
          },
          "io": {
            "type": "object",
            "description": "Rich I/O descriptions with concrete examples",
            "properties": {
              "inputs": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "name":        { "type": "string" },
                    "description": { "type": "string" },
                    "format":      { "type": "string" },
                    "example":     { "type": "string" }
                  },
                  "required": ["name"]
                }
              },
              "outputs": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "name":        { "type": "string" },
                    "description": { "type": "string" },
                    "format":      { "type": "string" },
                    "example":     { "type": "string" }
                  },
                  "required": ["name"]
                }
              }
            }
          },
          "docs": { "type": "string", "description": "Link to documentation (markdown file path or URL)" }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source", "target"],
        "properties": {
          "id":     { "type": "string", "description": "Optional edge ID (auto-generated as e1, e2, ... if omitted)" },
          "source": { "type": "string" },
          "target": { "type": "string" },
          "label":  { "type": "string" },
          "description": { "type": "string", "description": "Natural language description of what this transition does and why it exists" },
          "style":  { "type": "string", "enum": ["solid", "dashed"] },
          "actor":  { "type": "string", "enum": ["human", "ai", "script", "mixed"] },
          "details": {
            "type": "object",
            "properties": {
              "script":  { "type": "string" },
              "input":   { "type": "array", "items": { "type": "string" } },
              "output":  { "type": "array", "items": { "type": "string" } },
              "updates": { "type": "array", "items": { "type": "string" } },
              "docs":    { "type": "string" }
            }
          },
          "confidence": {
            "type": "string",
            "enum": ["high", "medium", "low", "unknown"],
            "description": "How confident the generation is in this edge's correctness"
          }
        }
      }
    },
    "legend": {
      "type": "object",
      "properties": {
        "trustLevels": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "label":       { "type": "string" },
              "borderStyle": { "type": "string" },
              "borderWidth": { "type": "number" },
              "color":       { "type": "string", "description": "Background color for provenance view" },
              "borderColor": { "type": "string", "description": "Border color for provenance view" },
              "tag": {
                "type": "object",
                "properties": {
                  "text":  { "type": "string" },
                  "bg":    { "type": "string" },
                  "color": { "type": "string" }
                }
              }
            }
          }
        }
      }
    },
    "_generationMode": {
      "type": "string",
      "enum": ["scan", "design"],
      "description": "How this graph was generated: scan (from existing project) or design (from objective)"
    },
    "_objective": {
      "type": "string",
      "description": "The natural language objective used to generate this graph (design mode only)"
    },
    "_generatedAt": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of when this graph was generated"
    },
    "plan": {
      "type": "object",
      "properties": {
        "summary": {
          "type": "object",
          "properties": {
            "goal": { "type": "string" },
            "tasks": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": { "type": "string" },
                  "title": { "type": "string" },
                  "nodeIds": { "type": "array", "items": { "type": "string" } }
                },
                "required": ["id", "title"]
              }
            }
          }
        },
        "annotations": {
          "type": "object",
          "properties": {
            "nodes": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "properties": {
                  "status": { "enum": ["add", "modify", "remove"] },
                  "description": { "type": "string" }
                },
                "required": ["status"]
              }
            },
            "edges": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "properties": {
                  "status": { "enum": ["add", "modify", "remove"] },
                  "description": { "type": "string" }
                },
                "required": ["status"]
              }
            },
            "modules": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "properties": {
                  "status": { "enum": ["add", "modify"] },
                  "description": { "type": "string" }
                },
                "required": ["status"]
              }
            }
          }
        }
      }
    }
  }
}
